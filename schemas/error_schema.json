{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "errors": {
      "type": "object",
      "additionalProperties": true
    },
    "errorMessages": {
      "type": "array",
      "items": {"type": "string"}
    },
    "errorCode": {"type": "integer"},
    "statusCode": {"type": "integer"},
    "errorsData": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "anyOf": [
    {"required": ["errorMessages"]},
    {"required": ["errors"]},
    {"required": ["errorCode"]}
  ],
  "additionalProperties": true
}