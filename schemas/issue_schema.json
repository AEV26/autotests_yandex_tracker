{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "key", "version", "summary", "queue", "createdAt"],
  "properties": {
    "id": {"type": "string"},
    "key": {"type": "string"},
    "version": {"type": "integer"},
    "summary": {"type": "string"},
    "description": {"type": ["string", "null"]},
    "type": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": "string"},
        "id": {"type": "string"},
        "key": {"type": "string"}
      },
      "required": []
    },
    "priority": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": "string"},
        "id": {"type": "string"},
        "key": {"type": "string"}
      },
      "required": []
    },
    "queue": {
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "id": {"type": "string"},
        "name": {"type": "string"}
      },
      "required": ["key"]
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}